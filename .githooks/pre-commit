#!/usr/bin/env bash
#
# Refuse to commit content that breaks the four fixed rules.
#
# This exists because the rules were written down and then held only because a
# human was watching. On 2026-08-06 an agent wrote an orchestrator that bypassed
# the lock and the budget, and it stopped when the owner stopped it — not because
# any check caught it. Documentation an agent has to read and obey is a
# suggestion; this is the part that does not depend on goodwill.
#
# Install (once, per clone):
#     git config core.hooksPath .githooks
#
# It only inspects what is being committed, runs in under a second, and costs no
# API quota. To bypass in a genuine emergency: git commit --no-verify — and say
# so in the commit message, because the next person will wonder.

set -u

REPO="$(git rev-parse --show-toplevel)"
PY="$REPO/.venv/bin/python3"
[ -x "$PY" ] || PY="python3"

# Only worth running when content or the syllabus is involved.
staged="$(git diff --cached --name-only --diff-filter=ACM)"
echo "$staged" | grep -qE '^certs/' || exit 0

fail=0

# 1-3: provenance, bookkeeping, ordering — for the certifications being touched
# ONLY. Checking the whole repo would block every commit on somebody else's
# pre-existing problem, which teaches people to pass --no-verify by reflex and
# ends with the hook doing nothing at all.
certs_touched="$(echo "$staged" | sed -n 's#^certs/\([^/.]*\)[/.].*#\1#p' | sort -u | tr '\n' ' ')"
if [ -n "$certs_touched" ]; then
    # shellcheck disable=SC2086
    if ! "$PY" "$REPO/scripts/check_provenance.py" $certs_touched 2>&1; then
        fail=1
    fi
fi

# 3b: do not write MORE content against a syllabus that is a quarter of its exam.
# Scoped to certifications whose content is being committed, not every one they
# touch, so that fixing a bad syllabus is never blocked by the syllabus being
# bad — the check would otherwise refuse exactly the commits that repair it.
content_certs="$(echo "$staged" | sed -n 's#^certs/\([^/]*\)/.*#\1#p' | sort -u | tr '\n' ' ')"
if [ -n "$content_certs" ]; then
    # shellcheck disable=SC2086
    if ! "$PY" "$REPO/scripts/check_syllabus.py" $content_certs 2>&1; then
        fail=1
    fi
fi

# 4: nothing below the quality floor may be committed. The generator already
# refuses to write it, so a violation here means it arrived some other way —
# by hand, by an agent writing files directly, or from a merge.
"$PY" - "$staged" <<'PYCODE'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    from teach.core import quality
except Exception:
    sys.exit(0)  # never block a commit because the check itself is broken

bad = []
for name in (sys.argv[1] or "").split():
    path = Path(name)
    if path.suffix != ".md" or path.parent.name in {"lab"}:
        continue
    kind = path.stem
    if kind not in {"content", "exercises"} or not path.exists():
        continue
    problems = quality.check(kind, path.read_text(errors="replace"))
    if problems:
        bad.append(f"  - {name}: {'; '.join(problems)}")

if bad:
    print("Below the quality floor, refusing to commit:")
    print("\n".join(bad))
    print("\nThe floor is a rejection threshold, not a target "
          "(pipeline.yaml -> quality). Regenerate; do not lower it.")
    sys.exit(1)
PYCODE
[ $? -eq 0 ] || fail=1

if [ "$fail" -ne 0 ]; then
    echo
    echo "Commit blocked. See AGENTS_SYNC.md for what each rule is and why."
    exit 1
fi
exit 0
