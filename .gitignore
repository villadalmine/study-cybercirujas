.venv/
__pycache__/
*.egg-info/
deploy/helm/values-local.yaml
certs/*/*/lab/terraform/.terraform/
certs/*/*/lab/terraform/*.tfstate*
certs/*/*/lab/status.yaml
media/**/*.mp4
media/**/.build/
.study/
.rejected/
.antigravitycli/

# Code graph: graph.json + GRAPH_REPORT.md ARE committed (they are the shared
# map other agents read). The cache is per-machine, cost.json is per-run, and
# graph.html is regenerated by every rebuild — committing it would add ~700 KB
# of churn to every commit for a file the browser reads locally.
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.html
# graphify backs up the curated graph into a dated directory before relabeling;
# per-machine history, not shared state.
graphify-out/20*/

# Credentials never live in the repo: this one is public, and until now the only
# ignore rule was .venv/ — so a .env dropped in here would have been committed
# and pushed. The pipeline reads plain environment variables; put them in
# ~/.config/teach-plat/litellm.env, which the timer loads and nothing here sees.
.env
.env.*
*.env
litellm.env
