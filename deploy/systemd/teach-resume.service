[Unit]
Description=teach-plat: one bounded content-generation pass when quota allows

[Service]
Type=oneshot
Environment=PATH=/home/dalmine/.local/bin:/usr/local/bin:/usr/bin
# Pin the standard Opus, NOT the 1M-context variant the CLI defaults to.
# Measured 2026-08-06 over 56 completions: opus-5[1m] spends 154k output tokens
# per authored topic against 60k for plain opus-5 — 2.6x the quota for 27% more
# material — because the 1M context window is loaded and billed on every call.
# Authoring a topic from one syllabus line does not need 1M of context.
# Result: 0.54 topics per quota window on [1m] against 1.40 on opus-5.
# Full model id, not the `opus` alias. The alias means "the latest Opus" and
# the CLI can fall back mid-run: on kcsa/1.2 the content came from opus-5 and its
# exercises from opus-4-8, under the same pin. meta.yaml records what actually
# answered, but a comparison needs the model held still.
# No model pin here: pipeline.yaml `generation.model` is the declared decision
# and this would override it. Set it here only to force a one-off experiment.
# `.env` in the repository, by the owner's decision (2026-08-13). The leading
# '-' means the timer starts normally when it is absent, which is the current
# state: translation falls back to claude, which works and merely costs more of
# the scarce resource. teach/core/__init__.py loads the same file for every
# other entry point, so this line only covers the case where systemd starts the
# process before Python is involved.
EnvironmentFile=-/var/home/dalmine/Nextcloud/Repos/teach-plat/.env
ExecStart=/var/home/dalmine/Nextcloud/Repos/teach-plat/scripts/resume-generation.sh
# The ceiling exists so a call that never returns cannot stall every later
# firing — but it must exceed the worst LEGITIMATE pass, and 2400 did not:
# on 2026-08-19 translating one 209 KB topic (3 completions at xhigh) ran
# past 40 min, systemd killed the pass mid-translation, nothing was written
# by design, and the next firing repeated it — 12 paid-and-discarded cycles
# (~1.9M tokens) before anyone noticed. Each completion is already bounded
# by pipeline.yaml completion_timeout_seconds=900, so this is a backstop
# against a hung SCRIPT, not a hung completion: 3 h ≈ twelve max-length
# completions, far beyond any real pass, far short of forever.
TimeoutStartSec=10800
KillMode=mixed
