{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What this exporter writes as a Killercoda scenario index.json (the fields documented in killercoda/scenario-examples).",
  "type": "object", "required": ["title", "details", "backend"],
  "properties": {
    "title": {"type": "string", "minLength": 1}, "description": {"type": "string"},
    "details": {"type": "object", "required": ["intro", "steps"], "properties": {
      "intro": {"$ref": "#/$defs/page"}, "finish": {"$ref": "#/$defs/page"},
      "steps": {"type": "array", "items": {"$ref": "#/$defs/page"}},
      "assets": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "required": ["file", "target"], "properties": {"file": {"type": "string"}, "target": {"type": "string"}}}}}}},
    "backend": {"type": "object", "required": ["imageid"], "properties": {"imageid": {"enum": ["ubuntu", "kubernetes-kubeadm-1node", "kubernetes-kubeadm-2nodes"]}}}},
  "$defs": {"page": {"type": "object", "required": ["text"], "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "foreground": {"type": "string"}, "background": {"type": "string"}, "verify": {"type": "string"}}}}
}
